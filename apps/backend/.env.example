NODE_ENV=development
PORT=3000
HOST=127.0.0.1
# Local-only placeholder fare; booking estimates are not production quotes.
DEV_FARE_BASE_AMOUNT=120
DATABASE_URL=
OTP_PROVIDER=development
ACCESS_TOKEN_SECRET=
OTP_HASH_SECRET=
# Keep this server-side only; never use a VITE_ or EXPO_PUBLIC_ prefix.
GOOGLE_MAPS_SERVER_API_KEY=
# Set each request ceiling only after verifying your billing allowance and safety margin.
# Unset limits disable that SKU (the backend will fail closed without making API calls).
GOOGLE_MAPS_MONTHLY_LIMIT_AUTOCOMPLETE_REQUESTS=
GOOGLE_MAPS_MONTHLY_LIMIT_PLACE_DETAILS_ESSENTIALS=
GOOGLE_MAPS_MONTHLY_LIMIT_GEOCODING=
GOOGLE_MAPS_MONTHLY_LIMIT_ROUTES_COMPUTE_ESSENTIALS=
GOOGLE_MAPS_MONTHLY_LIMIT_DYNAMIC_MAPS_LOADS=
