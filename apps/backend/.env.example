NODE_ENV=development
PORT=3000
HOST=127.0.0.1
DATABASE_URL=
OTP_PROVIDER=development
ACCESS_TOKEN_SECRET=
OTP_HASH_SECRET=

# Mapping providers. Keep OPENROUTESERVICE_API_KEY on the backend only.
PHOTON_BASE_URL=https://photon.komoot.io
OPENROUTESERVICE_API_KEY=
OPENROUTESERVICE_BASE_URL=https://api.heigit.org/openrouteservice
# driving-car is the closest supported general road profile, not an auto-rickshaw profile.
OPENROUTESERVICE_PROFILE=driving-car
MAP_TILE_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
MAPS_CACHE_TTL_SECONDS=300
MAPS_REQUEST_TIMEOUT_MS=10000
