{
  "name": "@ravero/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "tsx --test test/auth.test.ts test/booking.test.ts test/cors.test.ts test/googleMaps.test.ts",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate:dev": "prisma migrate dev --name init",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@ravero/shared": "workspace:*",
    "@prisma/client": "6.19.0",
    "dotenv": "^18.0.10",
    "express": "^5.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@ravero/config": "workspace:*",
    "@types/express": "^5.0.5",
    "@types/node": "^24.19.2",
    "eslint": "^10.14.0",
    "prisma": "6.19.0",
    "tsx": "^4.20.6",
    "typescript": "~6.0.3"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
