EXPO_PUBLIC_API_URL=http://localhost:3000
# Android Studio emulator default.
EXPO_PUBLIC_ANDROID_API_URL=http://10.0.2.2:3000
# Native Google Maps SDK keys; restrict each key to this app's package/bundle ID and Maps SDK.
EXPO_PUBLIC_GOOGLE_MAPS_ANDROID_API_KEY=
EXPO_PUBLIC_GOOGLE_MAPS_IOS_API_KEY=
# Browser key restricted to the deployed web origins and Maps JavaScript API.
EXPO_PUBLIC_GOOGLE_MAPS_WEB_API_KEY=
