{
  "expo": {
    "name": "RAVERO Customer",
    "slug": "ravero-customer",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/branding/ravero-icon.png",
    "userInterfaceStyle": "light",
    "scheme": "raverocustomer",
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000000"
        }
      ]
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/branding/ravero-adaptive-foreground.png",
        "monochromeImage": "./assets/branding/ravero-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/branding/favicon.png"
    }
  }
}
